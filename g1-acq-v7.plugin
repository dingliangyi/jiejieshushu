#!name=G1 ACQ v7.5.0
#!desc=被动采集原始 SKU，改写 2TB、20TB、30TB 商品 ID，支持本地报告与 JSON 导出
#!homepage=https://github.com/crhywun/g1-acq
#!author=crhywun
#!system=ios

[Rule]
# 全局拦截 UDP 443，促使支持回退的 HTTP/3 请求改走 TCP。
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT

[Script]
http-response ^https:\/\/one\.google\.com\/ script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.5.0/g1-acq.js, requires-body=true, timeout=10, tag=g1-acq
http-request ^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$ script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.5.0/g1-sku-report.js, timeout=10, tag=g1-sku-report

[MitM]
hostname = one.google.com
